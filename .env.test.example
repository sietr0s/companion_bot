# E2E Tests Configuration
# Скопируйте этот файл в .env.test и заполните реальными значениями
# НЕ КОММИТЬТЕ .env.test В GIT!

# =============================================================================
# Telegram API (Telethon)
# =============================================================================
# Получите на https://my.telegram.org → API development tools

TG_API_ID=123456
TG_API_HASH=abc123def456789...

# Тестовый Telegram-аккаунт (не используйте основной личный!)
TG_TEST_USER_PHONE=+79991234567

# Путь к session-файлу (создаётся при первой аутентификации)
TG_TEST_SESSION_PATH=/tmp/ms_starter_e2e_tests/test_e2e.session

# =============================================================================
# Telegram Bot (aiogram)
# =============================================================================
# Получите от @BotFather в Telegram (команда /newbot)

TG_BOT_TOKEN=bot123456:ABCdefGHIjklMNOpqrsTUVwxyz

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Отдельная БД для E2E тестов (не используйте production!)

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ms_starter_e2e

# =============================================================================
# Application Settings
# =============================================================================

MESSAGE_BUS=in_memory
APP_ENV=test

# JWT — обязательное поле
INTERNAL_SERVICE_KEY=internal-test-key
JWT_SECRET_KEY=test-secret-key-for-e2e-tests

# Admin seed-пользователь — обязательные поля
ADMIN_EMAIL=test-admin@example.com
ADMIN_PASSWORD=test-admin-password

# =============================================================================
# Notes
# =============================================================================
#
# Первая аутентификация:
#   1. Создайте директорию: mkdir -p /tmp/ms_starter_e2e_tests
#   2. Запустите тест: pytest tests/e2e/scenarios/test_registration.py::test_create_session -v
#   3. Введите SMS-код и 2FA пароль (если есть)
#   4. Session сохранится в TG_TEST_SESSION_PATH
#
# Запуск тестов:
#   pytest tests/e2e/ -v --env-file=.env.test
#
# Troubleshooting:
#   См. docs/e2e-testing.md раздел 7
