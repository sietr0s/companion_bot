# БД
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=modular_monolith
DB_DRIVER=postgresql+asyncpg
DATABASE_POOL_SIZE=5

# JWT
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Шина сообщений: in_memory | kafka
MESSAGE_BUS=in_memory

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=modular-monolith

# Приложение
APP_TITLE=Modular Monolith
DEBUG=False
PORT=8000

# Создание таблиц БД при старте (для разработки)
# В production установить в False и использовать Alembic миграции
CREATE_TABLES_ON_STARTUP=True

# Internal API (межмодульное взаимодействие)
INTERNAL_API_BASE_URL=http://localhost:8000/internal

# Telegram (Telethon)
TG_API_ID=0
TG_API_HASH=
TG_SESSION_DIR=sessions

# Telegram Bot (aiogram)
TG_BOT_TOKEN=
TG_BOT_MODE=polling
TG_BOT_WEBHOOK_SECRET=
APP_URL=http://localhost:8000

# SMTP (для модуля notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=App

# Шаблоны (Jinja2)
TEMPLATES_DIR=templates

# Admin (seed-пользователь)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=

# Media (файловое хранилище)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=uploads
MEDIA_MAX_SIZE_MB=50

# Classifier (AI-классификация)
CLASSIFIER_MODEL_NAME=facebook/bart-large-mnli
CLASSIFIER_DEVICE=-1
