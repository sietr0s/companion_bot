# БД
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=modular_monolith
DB_DRIVER=postgresql+asyncpg
DATABASE_POOL_SIZE=5

# JWT
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Шина сообщений: in_memory | kafka
MESSAGE_BUS=in_memory

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=modular-monolith

# Приложение
APP_TITLE=Modular Monolith
DEBUG=False
PORT=8000

# Создание таблиц БД при старте (для разработки)
# В production установить в False и использовать Alembic миграции
CREATE_TABLES_ON_STARTUP=True

# LLM (LangChain). mistral | openrouter | openai | openai_compat | stub
LLM_PROVIDER=openrouter
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# LangSmith (трейсы LangChain). Ключ: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=companion_bot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Batching: ждать следующее сообщение, иначе отправить батч
BATCH_MAX_SIZE=20
BATCH_IDLE_SECONDS=2.0

# STT: faster_whisper | stub. TTS v1 is stub only.
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TTS_PROVIDER=stub
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3

# Telegram (Telethon)
TG_API_ID=0
TG_API_HASH=
TG_SESSION_DIR=sessions

# Telegram Bot (aiogram)
TG_BOT_TOKEN=
TG_BOT_MODE=polling
TG_BOT_WEBHOOK_SECRET=
APP_URL=http://localhost:8000

# SMTP (для модуля notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=App

# Шаблоны (Jinja2)
TEMPLATES_DIR=templates

# Admin (seed-пользователь)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=

# Media (файловое хранилище)
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=uploads
MEDIA_MAX_SIZE_MB=50

# Classifier (AI-классификация)
CLASSIFIER_MODEL_NAME=knowledgator/gliclass-large-v1.0
CLASSIFIER_DEVICE=-1
CLASSIFIER_THRESHOLD=0.5
# Кэш весов моделей (HF / sentence-transformers / torch). В Docker: /app/models
MODEL_CACHE_DIR=models
