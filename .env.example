# SAFE_MODE=True: offline API, isolated SQLite, no AI/client/Kafka workers.
SAFE_MODE=False
SAFE_MODE_DATABASE_PATH=safe-mode.db

# Copy to .env and replace the admin credentials and JWT key before running.
JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=modular_monolith
DB_DRIVER=postgresql+asyncpg
DATABASE_POOL_SIZE=5
CREATE_TABLES_ON_STARTUP=False

APP_TITLE=Companion Bot
DEBUG=False
LOG_LEVEL=INFO
MESSAGE_BUS=in_memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=modular-monolith

# stub | mistral | google | openrouter | openai | openai_compat
LLM_PROVIDER=stub
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai/gpt-4o-mini
# LLM_PRESETS={"reply":{"temperature":0.9}}
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
MODEL_CACHE_DIR=models

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=companion_bot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

BATCH_MAX_SIZE=20
BATCH_IDLE_SECONDS=2.0
BEHAVIOR_TIMEZONE=Europe/Moscow
BEHAVIOR_SOFTMAX_TEMP=1.0
BEHAVIOR_INTAKE_TIMEOUT_S=60.0

STT_PROVIDER=stub
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# stub | openrouter | openai | openai_compat
TTS_PROVIDER=stub
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3

TG_API_ID=0
TG_API_HASH=
TG_SESSION_DIR=sessions
INSTAGRAM_POLL_INTERVAL_S=20
INSTAGRAM_SESSION_DIR=sessions/instagram
