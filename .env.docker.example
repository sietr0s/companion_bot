# Скопируйте в .env, если хотите переопределить значения для docker compose:
#   copy .env.docker.example .env

JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=False
LOG_LEVEL=INFO
APP_TITLE=Companion Bot
MESSAGE_BUS=in_memory
CREATE_TABLES_ON_STARTUP=False

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=modular_monolith

TG_API_ID=0
TG_API_HASH=
TG_MARK_READ_ON_SEND=true
TG_TYPING_ON_SEND=true
INSTAGRAM_MARK_READ_ON_SEND=true
INSTAGRAM_TYPING_ON_SEND=true

LLM_PROVIDER=openrouter
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# LLM_PRESETS={"reply":{"temperature":0.8,"top_p":0.95,"max_tokens":1024},"rag":{"temperature":0.1,"top_p":1.0,"max_tokens":512},"extract":{"temperature":0.0,"top_p":1.0,"max_tokens":1024}}
TTS_PROVIDER=fish
TTS_MODEL=s2.1-pro-free
TTS_VOICE=328249146f55468f9b4770231b2fe491
TTS_RESPONSE_FORMAT=opus
FISH_API_KEY=
FISH_TTS_BASE_URL=https://api.fish.audio/v1

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=companion_bot

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_GROUP_ID=modular-monolith

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5151
