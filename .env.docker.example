# ===========================================
# Docker Environment Configuration
# Скопируйте этот файл в .env и настройте переменные
# ===========================================

# Секретный ключ для JWT (ОБЯЗАТЕЛЬНО смените в production!)
# Сгенерировать случайный ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=super-secret-key-change-in-production

# Сервисный ключ для всех /internal/* endpoint'ов (обязателен)
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_KEY=change-this-to-a-random-service-key

# Алгоритм JWT
JWT_ALGORITHM=HS256

# Время жизни access токена (минуты)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Режим отладки
DEBUG=False

# ===========================================
# Шина сообщений
# in_memory - для монолита (по умолчанию)
# kafka - для микросервисов
# ===========================================
MESSAGE_BUS=in_memory

# Kafka конфигурация (используется при MESSAGE_BUS=kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=modular-monolith

# ===========================================
# Telegram API (обязательно для работы Telegram-модуля)
# Получить на https://my.telegram.org
# ===========================================
TG_API_ID=
TG_API_HASH=

# ===========================================
# SMTP для email-уведомлений
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=App

# ===========================================
# pgAdmin (используется с профилем admin)
# ===========================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5151

# ===========================================
# AI classifier
# Модели сохраняются в Docker volume huggingface_cache
# ===========================================
CLASSIFIER_MODEL_NAME=knowledgator/gliclass-large-v1.0
CLASSIFIER_DEVICE=-1
CLASSIFIER_THRESHOLD=0.5
