# SAFE_MODE=True: offline API, isolated SQLite, no AI/client/Kafka workers.
SAFE_MODE=False
SAFE_MODE_DATABASE_PATH=safe-mode.db

# Copy to .env before docker compose up --build.
# Replace passwords and JWT key; this file contains examples, never real secrets.
JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=modular_monolith
CREATE_TABLES_ON_STARTUP=False
APP_TITLE=Companion Bot
DEBUG=False
LOG_LEVEL=INFO
MESSAGE_BUS=in_memory

LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=openai/gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
STT_PROVIDER=stub
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TTS_PROVIDER=stub
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3

TG_API_ID=0
TG_API_HASH=
INSTAGRAM_POLL_INTERVAL_S=20
INSTAGRAM_SESSION_DIR=/app/sessions/instagram
BATCH_MAX_SIZE=20
BATCH_IDLE_SECONDS=2.0
BEHAVIOR_TIMEZONE=Europe/Moscow
BEHAVIOR_SOFTMAX_TEMP=1.0
BEHAVIOR_INTAKE_TIMEOUT_S=60.0
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=companion_bot

# Optional docker compose --profile admin up
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5151
